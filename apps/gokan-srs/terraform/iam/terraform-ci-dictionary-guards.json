{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DictionaryPageRateRule",
      "Effect": "Allow",
      "Action": [
        "wafv2:GetWebACL",
        "wafv2:UpdateWebACL",
        "wafv2:ListTagsForResource"
      ],
      "Resource": "arn:aws:wafv2:us-east-1:413976099932:global/webacl/CreatedByCloudFront-0fb8c740/*"
    },
    {
      "Sid": "DictionaryAlarmTopic",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:DeleteTopic",
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "sns:TagResource",
        "sns:UntagResource",
        "sns:ListTagsForResource",
        "sns:Subscribe",
        "sns:Unsubscribe",
        "sns:GetSubscriptionAttributes",
        "sns:SetSubscriptionAttributes"
      ],
      "Resource": "arn:aws:sns:eu-west-3:413976099932:gokan-srs-*dictionary-alarms*"
    },
    {
      "Sid": "DictionaryAlarms",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:TagResource",
        "cloudwatch:UntagResource",
        "cloudwatch:ListTagsForResource"
      ],
      "Resource": "arn:aws:cloudwatch:eu-west-3:413976099932:alarm:gokan-srs-*dictionary-*"
    },
    {
      "Sid": "DescribeAlarms",
      "Effect": "Allow",
      "Action": "cloudwatch:DescribeAlarms",
      "Resource": "*"
    }
  ]
}
