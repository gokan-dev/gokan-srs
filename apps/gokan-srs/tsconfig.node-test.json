{
  // The app's settings plus Node's types, for the tests that read the dataset checkout from disk
  // (the .node.test.ts files): every file the app loads is too many for an import.meta.glob.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node-test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.node.test.ts"],
  "exclude": []
}
