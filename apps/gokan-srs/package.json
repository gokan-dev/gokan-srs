{
  "name": "gokan-srs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --build --pretty false",
    "build": "vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "build:data": "bun --cwd dataset build",
    "build:kanji": "bun --cwd dataset build:kanji",
    "build:jlpt": "bun --cwd dataset build:jlpt",
    "build:jpdb": "bun --cwd dataset build:jpdb",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@gokan/dataset-schema": "workspace:*",
    "@react-oauth/google": "^0.13.4",
    "framer-motion": "14.8.0",
    "lucide-react": "1.64.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "terser": "^5.44.1"
  },
  "devDependencies": {
    "@gokan/analytics": "workspace:*",
    "@gokan/deploy": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.1.18",
    "typescript": "~6.0.3",
    "vite": "8.3.5",
    "vite-plugin-checker": "0.14.5",
    "vitest": "5.0.5"
  }
}
