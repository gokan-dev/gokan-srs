{
  "name": "gokan-srs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run sync:dataset && vite",
    "typecheck": "tsc --build --pretty false",
    "build": "bun run sync:dataset && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync:dataset": "bun scripts/sync-dataset.ts",
    "build:data": "bun --cwd dataset build:data && bun run sync:dataset",
    "build:kanji": "bun --cwd dataset build:kanji",
    "build:jlpt": "bun --cwd dataset build:jlpt",
    "build:jpdb": "bun --cwd dataset build:jpdb",
    "build:grammar": "bun --cwd dataset build:grammar && bun run sync:dataset",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.4",
    "framer-motion": "^12.26.2",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "react-virtuoso": "^4.18.1",
    "terser": "^5.44.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.2.5",
    "vite-plugin-checker": "^0.12.0",
    "vitest": "^4.0.17"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}