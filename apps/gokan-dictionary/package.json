{
  "name": "gokan-dictionary",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun run preview",
    "build": "svelte-kit sync && vite build --config vite.assets.config.ts && vite build && bun scripts/check-build.ts",
    "preview": "vite preview --config vite.assets.config.ts",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "svelte-kit sync && vitest run",
    "build:on-request": "DICTIONARY_ENTITY_PAGES=on-request bun run build",
    "sync": "svelte-kit sync"
  },
  "devDependencies": {
    "@gokan/deploy": "workspace:*",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.10.1",
    "sass": "^1.103.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "~6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@gokan/analytics": "workspace:*",
    "@gokan/dataset-schema": "workspace:*"
  }
}
