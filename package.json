{
  "name": "gokan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --cwd apps/gokan-srs dev",
    "check:layout": "bun scripts/check-layout.ts",
    "check:lighthouse": "bun scripts/check-lighthouse.ts",
    "check:parity": "bun apps/gokan-dictionary/scripts/check-parity.ts",
    "build": "bun --cwd apps/gokan-srs build",
    "dictionary:dev": "bun --cwd apps/gokan-dictionary dev",
    "dictionary:build": "bun --cwd apps/gokan-dictionary build",
    "dataset:build": "bun --cwd apps/gokan-srs build:data",
    "lint": "bun --cwd apps/gokan-dictionary sync && eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json && bun --cwd packages/dataset-schema typecheck && bun --cwd packages/analytics typecheck && bun --cwd packages/deploy typecheck && bun --cwd apps/gokan-srs typecheck && bun --cwd apps/gokan-dictionary typecheck",
    "test": "bun --cwd apps/gokan-srs test && bun --cwd apps/gokan-dictionary test && bun --cwd packages/deploy test && bun --cwd packages/dataset-schema test && bun --cwd packages/analytics test",
    "check:conventions": "bun scripts/check-conventions.ts",
    "check:duplicates": "bun scripts/check-duplicates.ts",
    "check:unused": "knip",
    "check": "bun run check:conventions && bun run lint && bun run typecheck && bun run test && bun run check:duplicates && bun run check:unused",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gokan/dataset-schema": "workspace:*",
    "@gokan/deploy": "workspace:*",
    "@types/node": "^24.10.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "jiti": "^2.7.0",
    "jscpd": "^4.3.0",
    "knip": "6.44.0",
    "lighthouse": "13.6.0",
    "svelte-eslint-parser": "1.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
