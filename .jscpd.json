{
  "$comment": "Duplicate-code check (bun run check:duplicates). Any clone above these floors fails it: share the code instead (see AGENTS.md, No duplication).",
  "path": ["apps/gokan-srs/src", "apps/gokan-srs/scripts", "apps/gokan-dictionary/src", "apps/gokan-dictionary/scripts", "packages", "scripts"],
  "format": ["typescript", "tsx", "javascript", "svelte", "scss"],
  "minTokens": 60,
  "minLines": 6,
  "threshold": 0,
  "ignore": ["**/node_modules/**", "**/dist/**", "**/__fixtures__/**"],
  "ignorePattern": ["^\\s*import\\s.*$"],
  "reporters": ["consoleFull"],
  "absolute": false,
  "gitignore": true,
  "silent": false
}
